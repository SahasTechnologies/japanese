          ]
        }
      ],
      "qaSections": [
        {
          "title": "ぶんぽう",
          "note": "Asking and saying the time",
          "pairs": [
            {
              "q": { "jp": "いま、何時ですか。", "en": "What time is it now?" },
              "a": { "jp": "いま、ごぜん／ごご 七時です。", "en": "It is 7 a.m./p.m. now." }
            },
            {
              "q": { "jp": "テニスの しあいは 何時ですか。", "en": "What time is the tennis match?" },
              "a": { "jp": "テニスの しあいは ごご 四時半です。", "en": "The tennis match is (at) 4:30 p.m." }
            }
          ]
        }
      ],
