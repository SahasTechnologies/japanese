            { "kanji": "三時 五十五分に", "kana": "さんじ ごじゅうごふんに", "en": "at 3:55" },
            { "kanji": "二時 十分です。", "kana": "にじ じゅっぷんです。", "en": "It is 2:10." }
          ]
