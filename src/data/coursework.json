      "grammarPractice": [
        {
          "title": "ぶんぽう れんしゅう 2",
          "note": "Asking and saying what time you do an activity",
          "example": {
            "q": { "jp": "何時に えいがを みますか。", "en": "What time will you watch the movie?", "bold": ["何時に"] },
            "a": { "jp": "ごぜん／ごご 七時に えいがを みます。", "en": "At 7:00 a.m./p.m., I will watch the movie.", "bold": ["ごぜん／ごご 七時に"] }
          },
          "pattern": {
            "headers": ["", "", "", "", ""],
            "rows": [
              ["Q", "何時", "に", "activity を", "しますか。"],
              ["A", "a.m./p.m. time", "に", "activity を", "します。"]
            ]
          },
          "drills": [
            ["何時", "に", "しあいを", "しますか。"],
            ["ごご 一時", "に", "しあいを", "します。"]
          ]
        },
        {
          "title": "ぶんぽう れんしゅう 3",
          "note": "Asking and saying when you do an activity. Non-specific time words do not use the particle に。",
          "example": {
            "q": { "jp": "いつ、 キャンプに いきますか。", "en": "When will you go to the camp?", "bold": ["いつ"] },
            "a": { "jp": "らいしゅう、 キャンプに いきます。", "en": "Next week, I'll go to the camp.", "bold": ["らいしゅう"] }
          },
          "pattern": {
            "headers": ["", "", "", ""],
            "rows": [
              ["Q", "いつ、", "activity を", "しますか。"],
              ["A", "Non-specific time、", "activity を", "します。"]
